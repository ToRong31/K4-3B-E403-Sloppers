# Copy to .env.deploy. Never commit .env.deploy.
POSTGRES_DB=vlearn_labspace
POSTGRES_USER=vlearn
POSTGRES_PASSWORD=replace-with-a-long-random-password
APP_PORT=18080

# The UI currently defaults to the fully functional demo/mock data source.
# Switch to http only after backend authentication endpoints are available.
VITE_DATA_SOURCE=mock

# Optional LLM configuration for backend AI calls.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
NVIDIA_API_KEY=

# Create a remotely managed tunnel whose public hostname is:
# labspace.torome.online -> http://web:80
CLOUDFLARE_TUNNEL_TOKEN=

# Only needed if this machine should create the tunnel and DNS record by API.
# Remove the API token after the one-time bootstrap succeeds.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# Copy to .env.deploy. Never commit .env.deploy.
POSTGRES_DB=vlearn_labspace
POSTGRES_USER=vlearn
POSTGRES_PASSWORD=replace-with-a-long-random-password
APP_PORT=18080

# Use the persisted backend/PostgreSQL data source in the deploy stack.
# Set this to mock only for an isolated UI demo.
VITE_DATA_SOURCE=http

# Secure cookies are required for the HTTPS Cloudflare hostname. For local
# http://127.0.0.1:18080 verification, temporarily set this to false.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax

# Optional LLM configuration for backend AI calls.
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-luna
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
NVIDIA_API_KEY=

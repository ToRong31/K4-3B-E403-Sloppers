APP_ENV=development
APP_DEBUG=true
APP_API_PREFIX=/api/v1
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# Choose exactly one provider: openai | anthropic | gemini
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Fill only the key for LLM_PROVIDER. Keep the others empty.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

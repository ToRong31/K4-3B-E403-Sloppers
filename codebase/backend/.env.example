APP_ENV=development
APP_DEBUG=true
APP_API_PREFIX=/api/v1
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5180,http://localhost:5173,http://localhost:5180,http://localhost:8000

# Local PostgreSQL exposed by Docker Compose.
POSTGRES_DB=vlearn_labspace
POSTGRES_USER=vlearn
POSTGRES_PASSWORD=vlearn_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://vlearn:vlearn_dev_password@127.0.0.1:5432/vlearn_labspace
DATABASE_ECHO=false
DATABASE_AUTO_CREATE=false

# Choose exactly one provider: openai | anthropic | gemini | nvidia
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-luna
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Fill only the key for LLM_PROVIDER. Keep the others empty.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
NVIDIA_API_KEY=

# NVIDIA hosted NIM is OpenAI-compatible. Override only for a self-hosted NIM.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
